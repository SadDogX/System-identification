{
  "name": "credentials-tracker",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "db:up": "docker compose up -d mysql",
    "db:migrate": "npm run migrate -w server",
    "db:seed": "npm run seed -w server",
    "db:demo": "npm run seed:demo -w server",
    "db:reset": "npm run reset -w server",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w client",
    "start": "npm run build && npm start -w server",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p client",
    "test": "npm test -w shared && npm test -w server",
    "db:studio": "npm run studio -w server"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
