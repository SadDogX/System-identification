DATABASE_URL="mysql://root:root@localhost:53308/credentials"
PORT=4300
# Сгенерируйте длинные случайные строки для продакшена
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
# Первый администратор, создаётся командой npm run db:seed
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD="admin12345"

# Почта (оповещения о красных и жёлтых сроках). Пусто — письма не отправляются.
# Для локальной проверки: docker compose up -d mailpit, письма видны на http://localhost:8026
SMTP_HOST="localhost"
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Учёт удостоверений <noreply@credentials.local>"
APP_URL="http://localhost:4300"

# Окружение: development | production. В production сервер запускается на всех ядрах (кластер)
NODE_ENV=development
# Число рабочих процессов. Пусто — production: все ядра, development: 1
CLUSTER_WORKERS=
