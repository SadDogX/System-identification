generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                 @id @default(autoincrement())
  fullName           String              @db.VarChar(200)
  login              String              @unique @db.VarChar(50)
  passwordHash       String              @db.VarChar(255)
  role               Role                @default(USER)
  phone              String?             @db.VarChar(50)
  email              String?             @db.VarChar(150)
  isActive           Boolean             @default(true)
  isDeleted          Boolean             @default(false)
  mustChangePassword Boolean             @default(true)
  tokenVersion       Int                 @default(0)
  uiSettings         Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  positionId         Int?
  auditAsActor       AuditLog[]          @relation("AuditActor")
  auditAsTarget      AuditLog[]          @relation("AuditTarget")
  sentMessages       Message[]
  notifications      Notification[]
  position           Position?           @relation(fields: [positionId], references: [id])
  updatedCredentials UserCredential[]    @relation("CredentialEditor")
  credentials        UserCredential[]    @relation("CredentialOwner")
  radarCards         RadarCard[]
  ifoProposals       IfoProposal[]       @relation("IfoProposer")
  workSchedule       WorkScheduleEntry[]
  scheduleTemplates  ScheduleTemplate[]
  schedulePeriods    SchedulePeriod[]

  @@index([role, isDeleted])
  @@index([positionId], map: "User_positionId_fkey")
}

/// Справочник должностей
model Position {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(150)
  sortOrder  Int      @default(0)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  users      User[]
}

/// Справочник удостоверений: название и срок действия
model Credential {
  id              Int              @id @default(autoincrement())
  name            String           @db.VarChar(200)
  validityMonths  Int
  sortOrder       Int              @default(0)
  isArchived      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userCredentials UserCredential[]
}

/// Конкретное удостоверение конкретного сотрудника
model UserCredential {
  id                  Int        @id @default(autoincrement())
  userId              Int
  credentialId        Int
  number              String?    @db.VarChar(100)
  issueDate           DateTime?  @db.Date
  expiryDate          DateTime?  @db.Date
  comment             String?    @db.Text
  isMarkedForDeletion Boolean    @default(false)
  updatedById         Int?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  photoFile           String?    @db.VarChar(100)
  photoMime           String?    @db.VarChar(50)
  credential          Credential @relation(fields: [credentialId], references: [id])
  updatedBy           User?      @relation("CredentialEditor", fields: [updatedById], references: [id])
  user                User       @relation("CredentialOwner", fields: [userId], references: [id])

  @@unique([userId, credentialId])
  @@index([expiryDate])
  @@index([credentialId], map: "UserCredential_credentialId_fkey")
  @@index([updatedById], map: "UserCredential_updatedById_fkey")
}

/// Карта безопасности «Радар»
model RadarCard {
  id              Int      @id @default(autoincrement())
  userId          Int
  customerName    String   @db.VarChar(200)
  mainInfo        String   @db.Text
  event           String   @db.Text
  actionsTaken    String   @db.Text
  incidentDate    DateTime @db.Date
  requiredActions String?  @db.Text
  stoppedWork     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])

  @@index([incidentDate])
  @@index([userId, incidentDate])
}

model IfoProposal {
  id              Int      @id @default(autoincrement())
  proposerId      Int
  title           String   @db.VarChar(300)
  problem         String   @db.Text
  proposal        String   @db.Text
  expectedBenefit String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  proposer        User     @relation("IfoProposer", fields: [proposerId], references: [id])

  @@index([createdAt])
  @@index([proposerId, createdAt])
}

model ScheduleTemplate {
  id         Int       @id @default(autoincrement())
  userId     Int
  name       String    @db.VarChar(200)
  workDays   Int
  restDays   Int
  cycleStart DateTime  @db.Date
  validFrom  DateTime  @db.Date
  validTo    DateTime? @db.Date
  isActive   Boolean   @default(true)
  version    Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, validFrom])
}

model SchedulePeriod {
  id        Int                  @id @default(autoincrement())
  userId    Int
  type      SchedulePeriodType
  status    SchedulePeriodStatus @default(PLANNED)
  startDate DateTime             @db.Date
  endDate   DateTime             @db.Date
  note      String?              @db.Text
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate, endDate])
}

model WorkScheduleEntry {
  id        Int           @id @default(autoincrement())
  userId    Int
  date      DateTime      @db.Date
  status    WorkDayStatus
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime      @updatedAt

  @@unique([userId, date])
  @@index([date])
}

model Notification {
  id          Int              @id @default(autoincrement())
  userId      Int
  kind        NotificationKind
  level       String?          @db.VarChar(10)
  title       String           @db.VarChar(300)
  body        String           @db.Text
  link        String?          @db.VarChar(300)
  messageId   Int?
  dedupKey    String?          @unique
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  dismissedAt DateTime?
  message     Message?         @relation(fields: [messageId], references: [id])
  user        User             @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([messageId], map: "Notification_messageId_fkey")
}

model Message {
  id          Int            @id @default(autoincrement())
  senderId    Int
  subject     String         @db.VarChar(200)
  body        String         @db.Text
  isBroadcast Boolean        @default(false)
  createdAt   DateTime       @default(now())
  sender      User           @relation(fields: [senderId], references: [id])
  deliveries  Notification[]

  @@index([senderId], map: "Message_senderId_fkey")
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  actorId      Int?
  action       String   @db.VarChar(50)
  entityType   String   @db.VarChar(50)
  entityId     Int?
  targetUserId Int?
  diff         Json?
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id])
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id])

  @@index([createdAt])
  @@index([targetUserId])
  @@index([actorId], map: "AuditLog_actorId_fkey")
}

model Setting {
  key   String @id @db.VarChar(50)
  value String @db.VarChar(200)
}

enum SchedulePeriodType {
  WORK
  REST
  VACATION
  SICK_LEAVE
  ABSENCE
  UNDETERMINED
}

enum SchedulePeriodStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorkDayStatus {
  WORK
  FREE_SHIFT
  TRAVEL
  SICK_LEAVE
  VACATION
  TRAINING
}

enum Role {
  ADMIN
  USER
}

enum NotificationKind {
  EXPIRY
  MESSAGE
  DIGEST
}
