{
  "name": "@app/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env src/server.ts",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "node --env-file=.env prisma/seed.ts",
    "seed:demo": "node --env-file=.env prisma/seed-demo.ts",
    "reset": "prisma migrate reset --force",
    "test": "node --env-file=.env.test --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "studio": "prisma studio --browser none --port 5555"
  },
  "dependencies": {
    "@app/shared": "*",
    "@prisma/client": "^5.22.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "prisma": "^5.22.0"
  },
  "prisma": {
    "seed": "node --env-file=.env prisma/seed.ts"
  },
  "description": "Сервер API (Express + Prisma), модули в src/modules"
}
